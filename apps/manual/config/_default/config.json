{
	"baseURL": "//pmndrs.github.io/postprocessing/manual/",
	"title": "Post-Processing Manual",
	"disableHugoGeneratorInject": true,
	"enableRobotsTXT": true,
	"googleAnalytics": "UA-123-45",
	"disableLiveReload": true,
	"buildFuture": true,
	"publishDir": "../../public/manual/",
	"outputs": {
		"home": ["html", "markdown"],
		"page": ["html", "markdown"],
		"section": ["html", "markdown"]
	},
	"markup": {
		"goldmark": {
			"renderer": {
				"unsafe": true
			}
		},
		"highlight": {
			"noClasses": false
		}
	},
	"languages": {
		"en": {
			"weight": 1
		}
	}
}
