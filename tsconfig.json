{
	"include": [
		"./src",
		"./test"
	],
	"compilerOptions": {
		// File Layout
		"rootDir": ".",
		"outDir": "./dist",
		"paths": {
			"temp/*": ["./temp/*"],
			"support/*": ["./test/support/*"]
		},
		// Environment Settings
		"moduleResolution": "bundler",
		"module": "esnext",
		"target": "es2025",
		"types": ["node", "three"],
		// Style Options
		"noImplicitReturns": true,
		"noImplicitOverride": true,
		// Other
		"allowSyntheticDefaultImports": true,
		"noUncheckedSideEffectImports": true,
		"resolveJsonModule": true,
		"sourceMap": false,
		"skipLibCheck": true
	}
}
