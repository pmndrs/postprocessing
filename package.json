{
	"name": "postprocessing",
	"version": "7.0.0-beta.16",
	"description": "An advanced post-processing library for three.js.",
	"homepage": "https://github.com/pmndrs/postprocessing",
	"license": "Zlib",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": ">=11 <12",
			"onFail": "error"
		},
		"runtime": {
			"name": "node",
			"version": ">=24",
			"onFail": "error"
		}
	},
	"keywords": [
		"effect",
		"filter",
		"framegraph",
		"gbuffer",
		"pass",
		"rendering",
		"rendertexture",
		"rtt",
		"three",
		"webgl",
		"webgpu"
	],
	"author": {
		"name": "Raoul van Rüschen",
		"email": "vanruesc@outlook.de"
	},
	"repository": {
		"url": "git+https://github.com/pmndrs/postprocessing.git"
	},
	"bugs": {
		"url": "https://github.com/pmndrs/postprocessing/issues"
	},
	"files": [
		"./dist"
	],
	"publishConfig": {
		"tag": "beta"
	},
	"scripts": {
		"clean": "del-cli temp dist public",
		"tsc": "tsc -p tsconfig.d.json",
		"lint": "eslint --fix src",
		"build": "node esbuild",
		"watch": "node esbuild -w",
		"watch:all": "pnpm --parallel -r watch",
		"deploy": "cpy llms.txt public/llms.txt",
		"gzip": "gzipper c \"public\"",
		"doc": "typedoc --tsconfig tsconfig.d.json",
		"pretest": "run-s clean tsc lint build",
		"test": "run-s test:*",
		"test:unit": "node --experimental-strip-types --test \"test/unit/**/*.ts\"",
		"posttest": "run-s doc",
		"prepublishOnly": "run-s test"
	},
	"peerDependencies": {
		"three": ">= 0.179.0 < 0.186.0"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@types/three": "catalog:",
		"cpy-cli": "catalog:",
		"del-cli": "catalog:",
		"esbuild": "catalog:",
		"esbuild-plugin-glsl": "catalog:",
		"eslint": "catalog:",
		"eslint-config-aether": "catalog:",
		"gzipper": "catalog:",
		"npm-run-all": "catalog:",
		"three": "catalog:",
		"typedoc": "catalog:",
		"typedoc-plugin-markdown": "catalog:",
		"typedoc-plugin-mdn-links": "catalog:",
		"typescript": "catalog:"
	}
}
